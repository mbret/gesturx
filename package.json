{
	"name": "gesturx",
	"private": false,
	"version": "0.0.0-semantically-released",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mbret/gesturx.git"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:lib": "tsc && cross-env LIB_MODE=true vite build && tsc -p tsconfig.build.json",
		"preview": "vite preview",
		"check": "npx @biomejs/biome check .",
		"check:readme": "node scripts/check-readme.mjs",
		"check:package": "node -e \"require('node:fs').accessSync(require('./package.json').types)\" && attw --pack . --profile esm-only",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"prepare": "husky"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "2.5.14",
		"@chakra-ui/react": "^3.37.0",
		"@emotion/react": "^11.14.0",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.1",
		"cross-env": "^10.1.0",
		"happy-dom": "^20.14.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-icons": "^5.7.0",
		"rollup-plugin-node-externals": "^9.0.1",
		"rxjs": "^7.8.2",
		"semantic-release": "25.0.9",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"rxjs": "7.x"
	},
	"lint-staged": {
		"*": [
			"biome check --no-errors-on-unmatched --files-ignore-unknown=true --write"
		]
	}
}
